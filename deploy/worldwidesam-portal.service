[Unit]
Description=Worldwide Sam portal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/lib/worldwidesam-portal/current
EnvironmentFile=-%h/.config/worldwidesam-portal/environment
ExecStart=/usr/bin/python3 server.py --host 127.0.0.1 --port 4178 --database %h/.local/share/worldwidesam-portal/blog.sqlite3 --private-sites %h/.local/share/worldwidesam-portal/private-sites
Restart=on-failure
RestartSec=5s
UMask=0077
CapabilityBoundingSet=
LockPersonality=true
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=%h/.local/lib/worldwidesam-portal
ReadWritePaths=%h/.local/share/worldwidesam-portal
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
TasksMax=64

[Install]
WantedBy=default.target
